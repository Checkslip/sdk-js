{
  "name": "@checkslip/sdk",
  "version": "0.6.1",
  "packageManager": "bun@1.4.4",
  "description": "Official JavaScript and TypeScript client for the Checkslip API: look up Thai bank transfers from slip QR codes or images.",
  "keywords": [
    "checkslip",
    "slip",
    "promptpay",
    "thai bank",
    "transfer lookup",
    "api client"
  ],
  "license": "MIT",
  "author": "Checkslip",
  "homepage": "https://checkslip.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Checkslip/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/Checkslip/sdk-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.th.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "generate": "bun scripts/generate.mjs",
    "generate:check": "bun scripts/generate.mjs --check",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:dist": "node test/dist/smoke.mjs && node test/dist/smoke.cjs",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.3",
    "@types/node": "18.19.130",
    "openapi-typescript": "7.13.0",
    "publint": "0.3.15",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "@types/bun": "^1.4.4"
  }
}
